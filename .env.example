# Copia este archivo como .env si quieres cambiar algo. Sin .env todo funciona con estos valores.

# Zona horaria de toda la aplicacion
TZ=America/Bogota

# Base de datos (PostgreSQL 17). El puerto no se publica fuera de la red de Docker.
POSTGRES_DB=esivans
POSTGRES_USER=esivans
POSTGRES_PASSWORD=esivans_demo

# Puertos publicados en el equipo
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Adaptador de IA: mock (determinista, sin internet), groq, groq_text o gemini.
#   groq      -> Groq interpreta los mensajes y lee la foto del tablero.
#   groq_text -> Groq interpreta los mensajes; la foto no se envia a Groq y usa la lectura de ejemplo.
# En el simulador hay un conmutador "IA: Groq / Groq (texto) / Simulada" para cambiar sin reiniciar.
AI_PROVIDER=mock
# Groq (AI_PROVIDER=groq o groq_text): la clave va solo en .env, nunca en el repositorio. Sin clave responde la IA simulada.
GROQ_API_KEY=
# Modelo de texto (interpreta el mensaje) y modelo de vision (lee la foto del tablero). Los limites son por modelo.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
# Modelo de la familia Flash segun la documentacion oficial vigente (solo con AI_PROVIDER=gemini)
GEMINI_MODEL=

# WhatsApp simulado: secreto con el que se firma y se verifica el webhook (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=demo-secret
WHATSAPP_VERIFY_TOKEN=demo-verify-token

# Modo demo: habilita /api/dev/* (simulador y "Reiniciar demo")
DEMO_MODE=true
